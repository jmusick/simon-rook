---
import { Image, getImage } from "astro:assets";
import { Icon } from "astro-icon/components";
import Layout from "../../layouts/Layout.astro";
import ReaderNote from "../../components/ReaderNote.astro";
import { PERSON_REF, SITE_NAME, SITE_URL } from "../../config/site";
import { BOOKS, formatPublished, type Book } from "../../data/books";

export function getStaticPaths() {
	return BOOKS.map((book) => ({ params: { slug: book.slug }, props: { book } }));
}

interface Props {
	book: Book;
}

const { book } = Astro.props;
const canonicalUrl = `${SITE_URL}/books/${book.slug}/`;

// Absolute URLs for the built images: the share card (or the cover, when the
// book has no card) for Open Graph / Twitter, and the cover for the Book schema.
const socialImage = await getImage({ src: book.socialImage ?? book.cover, format: "jpg", quality: 85 });
const socialImageUrl = new URL(socialImage.src, SITE_URL).href;
const socialImageAlt = book.socialImage ? (book.socialImageAlt ?? book.coverAlt) : book.coverAlt;
const coverImage = await getImage({ src: book.cover, format: "jpg", quality: 85 });
const coverImageUrl = new URL(coverImage.src, SITE_URL).href;

// Chapters are numbered continuously across parts, matching the manuscript.
let chapterNumber = 0;

const bookSchema = {
	"@type": "Book",
	name: book.title,
	alternateName: `${book.title}: ${book.subtitle}`,
	author: PERSON_REF,
	description: book.blurb,
	bookFormat: "https://schema.org/EBook",
	datePublished: book.published,
	inLanguage: "en",
	url: canonicalUrl,
	image: coverImageUrl,
	...(book.retailers.length > 0 && {
		offers: book.retailers.map((r) => ({
			"@type": "Offer",
			url: r.href,
			availability: book.available
				? "https://schema.org/InStock"
				: "https://schema.org/PreOrder",
		})),
	}),
};

const breadcrumbSchema = {
	"@type": "BreadcrumbList",
	itemListElement: [
		{ "@type": "ListItem", position: 1, name: "Home", item: `${SITE_URL}/` },
		{ "@type": "ListItem", position: 2, name: "Books", item: `${SITE_URL}/books/` },
		{ "@type": "ListItem", position: 3, name: book.title, item: canonicalUrl },
	],
};

const structuredData = {
	"@context": "https://schema.org",
	"@graph": [bookSchema, breadcrumbSchema],
};
---

<Layout
	title={`${book.title} — ${SITE_NAME}`}
	description={book.blurb}
	canonicalUrl={canonicalUrl}
	socialImageUrl={socialImageUrl}
	socialImageAlt={socialImageAlt}
	socialImageWidth={socialImage.attributes.width}
	socialImageHeight={socialImage.attributes.height}
	ogType="book"
	structuredData={structuredData}
	active="books"
>
	<Fragment slot="head">
		<meta property="book:author" content={`${SITE_URL}/about/`} />
		<meta property="book:release_date" content={book.published} />
	</Fragment>
	<div class="page">
		<div class="book-layout">
			<aside class="book-aside">
				<div class="book-cover">
					<Image
						src={book.cover}
						alt={book.coverAlt}
						widths={[320, 640]}
						sizes="(max-width: 900px) 300px, 320px"
						loading="eager"
						fetchpriority="high"
					/>
				</div>

				<div class="retailers">
					{book.retailers.map((r) => (
						<a
							class={`btn ${r.primary ? "btn-primary" : "btn-secondary"}`}
							href={r.href}
							target="_blank"
							rel="noopener noreferrer"
						>
							<Icon name={r.icon} aria-hidden="true" />
							Read on {r.label}
						</a>
					))}
				</div>

				<dl class="detail-list">
					<dt>Format</dt>
					<dd>{book.format}</dd>
					<dt>Published</dt>
					<dd>{formatPublished(book.published)}</dd>
					<dt>Length</dt>
					<dd>{book.wordCount}</dd>
					<dt>ASIN</dt>
					<dd>{book.asin}</dd>
				</dl>
			</aside>

			<div class="book-main">
				<div>
					{book.available
						? <span class="badge">Available now</span>
						: <span class="badge badge-neutral">Coming soon</span>}
					<h1 class="book-title" style="margin-top: var(--space-4);">{book.title}</h1>
					<p class="book-subtitle" style="margin-top: var(--space-4);">{book.subtitle}</p>
				</div>

				<div class="prose">
					{book.description.map((para, i) => (
						<p class={i === 0 ? "lede" : undefined}>{para}</p>
					))}
				</div>

				<section>
					<h2>By the end of the book</h2>
					<ul class="feature-list" style="margin-top: var(--space-5);">
						{book.promises.map((item) => (
							<li>
								<Icon name="lucide:check" aria-hidden="true" />
								<span>{item}</span>
							</li>
						))}
					</ul>
				</section>

				<section>
					<h2>What's inside</h2>
					<p style="margin-top: var(--space-4);">
						Every chapter opens with a recognizable modern situation, introduces one Stoic
						idea in plain language, says clearly what that idea does <em>not</em> mean, and
						ends with a concrete exercise you can do the same day.
					</p>
					<ol class="contents" style="margin-top: var(--space-5);">
						{book.parts.map((part) => (
							<li class="contents-part">
								<span class="contents-part-name">{part.name}</span>
								{part.note && <p class="contents-note">{part.note}</p>}
								{part.chapters.length > 0 && (
									<ol class="contents-chapters">
										{part.chapters.map((chapter) => {
											chapterNumber += 1;
											return (
												<li>
													<span class="contents-n">{chapterNumber}.</span>
													<span>{chapter}</span>
												</li>
											);
										})}
									</ol>
								)}
							</li>
						))}
					</ol>
				</section>

				<section>
					<h2>Reader note</h2>
					<div style="margin-top: var(--space-4);">
						<ReaderNote book={book} />
					</div>
				</section>
			</div>
		</div>
	</div>
</Layout>
