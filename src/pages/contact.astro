---
import { Icon } from "astro-icon/components";
import Layout from "../layouts/Layout.astro";
import {
	ACTIVE_SOCIALS,
	CONTACT_EMAIL,
	SITE_NAME,
	SITE_URL,
	TURNSTILE_SITE_KEY,
} from "../config/site";

const canonicalUrl = `${SITE_URL}/contact/`;
const description = `Contact ${SITE_NAME} — reader mail, press, and rights enquiries.`;

/**
 * `astro dev` always uses Cloudflare's documented always-passes test key. The
 * real widget is registered against the production hostnames, so it renders an
 * "invalid domain" error on localhost — pinning dev to the test key means the
 * form is always visible while working on the page, and a production key can
 * never be exercised locally by accident. Builds use TURNSTILE_SITE_KEY, which
 * is committed with an environment override; see src/config/site.ts.
 */
const TURNSTILE_DEV_TEST_KEY = "1x00000000000000000000AA";
const turnstileSiteKey = import.meta.env.DEV ? TURNSTILE_DEV_TEST_KEY : TURNSTILE_SITE_KEY;

/**
 * `astro dev` serves pages but not Pages Functions, so /api/contact 404s here.
 * Say so on the page rather than letting the form look broken.
 */
const functionUnavailable = import.meta.env.DEV;
---

<Layout
	title={`Contact — ${SITE_NAME}`}
	description={description}
	canonicalUrl={canonicalUrl}
	active="contact"
>
	<div class="page page-narrow">
		<span class="eyebrow">Contact</span>
		<hr class="rule-short" />
		<h1>Get in touch</h1>

		<div class="prose" style="margin-top: var(--space-6);">
			<p class="lede">
				Reader mail, press enquiries, translation and rights questions all reach the same
				inbox. Use the form below. It's read by a person, though not always quickly.
			</p>

			<p>
				If you're writing about something in a book, mentioning the chapter helps. If
				you've found an error — a misattributed quotation, a broken citation, a translation
				that doesn't hold up — please say so plainly. Corrections are welcome and get made.
			</p>

			{/*
				The published address is deliberately not shown — everything goes through
				the form. The one exception is a build with no Turnstile key, where the
				form can't render at all; without this fallback the page would offer no
				way to make contact whatsoever.
			*/}
			{!turnstileSiteKey && (
				<p class="panel" style="font-size: var(--text-body-lg);">
					<a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a>
				</p>
			)}

			{turnstileSiteKey && (
				<>
					<form class="contact-form panel" id="contact-form" novalidate>
						<div class="field">
							<label for="cf-name">Name</label>
							<input id="cf-name" name="name" type="text" maxlength="100" required autocomplete="name" />
						</div>

						<div class="field">
							<label for="cf-email">Email</label>
							<input id="cf-email" name="email" type="email" required autocomplete="email" />
							<span class="field-hint">So a reply can reach you. Nothing else is done with it.</span>
						</div>

						<div class="field">
							<label for="cf-subject">Subject <span class="optional">optional</span></label>
							<input id="cf-subject" name="subject" type="text" maxlength="150" />
						</div>

						<div class="field">
							<label for="cf-message">Message</label>
							<textarea id="cf-message" name="message" rows="8" minlength="10" maxlength="4000" required
							></textarea>
						</div>

						{/* Honeypot: off-screen and hidden from assistive tech, so only a bot fills it. */}
						<div class="honeypot" aria-hidden="true">
							<label for="cf-website">Leave this field empty</label>
							<input id="cf-website" name="website" type="text" tabindex="-1" autocomplete="off" />
						</div>

						{/*
							Rendered explicitly by the script below (api.js loads with
							render=explicit) so it can pick `size` from the width this container
							actually has. The default 300px widget overflows the ~246px content box
							of a 320px viewport, and `flexible` also has a 300px minimum.
						*/}
						<div
							class="turnstile-slot"
							id="cf-turnstile"
							data-sitekey={turnstileSiteKey}
						>
						</div>

						<div class="form-actions">
							<button type="submit" class="btn btn-primary" id="cf-submit">Send message</button>
							<p class="form-status" id="cf-status" role="status" aria-live="polite"></p>
						</div>

						{functionUnavailable && (
							<p class="dev-note">
								<strong>Dev server only:</strong> this is Turnstile's test key, and
								<code>astro dev</code> doesn't serve <code>/api/contact</code>, so sending
								will fail here. Use <code>npm run build</code> then
								<code>npx wrangler pages dev dist</code> to exercise the real endpoint.
							</p>
						)}
					</form>
				</>
			)}

			<h2>One thing this inbox can't do</h2>

			<p>
				It can't give personal advice about a mental-health situation. The books are
				philosophy, not treatment, and no email exchange is a substitute for talking to
				someone qualified. If anxiety, compulsive behavior, depression, trauma, or lost
				sleep is interfering with daily life, that's worth taking to a professional rather
				than to an author.
			</p>
		</div>

		{ACTIVE_SOCIALS.length > 0 && (
			<section class="section-sm">
				<h2>Elsewhere</h2>
				<nav class="social-nav" style="margin-top: var(--space-4);" aria-label="Author profiles">
					{ACTIVE_SOCIALS.map((s) => (
						<a
							href={s.href}
							target="_blank"
							rel="noopener noreferrer"
							aria-label={s.label}
							class="social-link"
						>
							<Icon name={s.icon} aria-hidden="true" />
						</a>
					))}
				</nav>
			</section>
		)}
	</div>

	{turnstileSiteKey && (
		<script
			slot="head"
			is:inline
			src="https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit&onload=srTurnstileReady"
			async
			defer></script>
	)}
</Layout>

{turnstileSiteKey && (
	<script>
		// Turnstile: 300px "normal" when the container can hold it, otherwise the
		// 150px "compact" widget (the documented narrow-layout size). Cloudflare's
		// `flexible` size has a 300px minimum, so it can't fix a 246px container.
		const NORMAL_WIDGET_WIDTH = 300;
		const slot = document.getElementById("cf-turnstile");
		let widgetId: string | undefined;

		const mountTurnstile = () => {
			if (!slot || !window.turnstile?.render) return;
			if (widgetId !== undefined) window.turnstile.remove?.(widgetId);
			widgetId = window.turnstile.render(slot, {
				sitekey: slot.dataset.sitekey ?? "",
				theme: "dark",
				appearance: "interaction-only",
				size: slot.clientWidth >= NORMAL_WIDGET_WIDTH ? "normal" : "compact",
			});
		};

		// api.js may finish loading before or after this module runs.
		if (window.turnstile) mountTurnstile();
		else window.srTurnstileReady = mountTurnstile;

		// Rotation or window resize can cross the threshold; a widget of the wrong
		// size is rebuilt (this drops any unsubmitted token, and a fresh one follows).
		let lastNormal = (slot?.clientWidth ?? 0) >= NORMAL_WIDGET_WIDTH;
		window.addEventListener("resize", () => {
			const normal = (slot?.clientWidth ?? 0) >= NORMAL_WIDGET_WIDTH;
			if (normal !== lastNormal) {
				lastNormal = normal;
				mountTurnstile();
			}
		});

		const form = document.getElementById("contact-form") as HTMLFormElement | null;
		const status = document.getElementById("cf-status");
		const submit = document.getElementById("cf-submit") as HTMLButtonElement | null;

		if (form && status && submit) {
			const setStatus = (text: string, state: "" | "ok" | "error") => {
				status.textContent = text;
				status.dataset.state = state;
			};

			form.addEventListener("submit", async (event) => {
				event.preventDefault();

				if (!form.checkValidity()) {
					form.reportValidity();
					return;
				}

				const data = new FormData(form);
				// Turnstile injects this hidden input into the form once solved.
				const captchaToken = String(data.get("cf-turnstile-response") ?? "");
				if (!captchaToken) {
					setStatus("Please wait a moment for the verification check, then try again.", "error");
					return;
				}

				submit.disabled = true;
				setStatus("Sending…", "");

				try {
					const response = await fetch("/api/contact", {
						method: "POST",
						headers: { "Content-Type": "application/json" },
						body: JSON.stringify({
							name: data.get("name"),
							email: data.get("email"),
							subject: data.get("subject"),
							message: data.get("message"),
							website: data.get("website"),
							captchaToken,
						}),
					});

					const result = (await response.json().catch(() => null)) as
						| { message?: string; error?: string }
						| null;

					if (!response.ok) {
						setStatus(result?.error ?? "Something went wrong. Please try again.", "error");
						// A token is single-use — without a reset the next attempt fails too.
						window.turnstile?.reset(widgetId);
						submit.disabled = false;
						return;
					}

					form.reset();
					window.turnstile?.reset(widgetId);
					setStatus(result?.message ?? "Thanks — your message has been sent.", "ok");
					submit.disabled = false;
				} catch {
					setStatus("Could not reach the server. Please try again in a moment.", "error");
					window.turnstile?.reset(widgetId);
					submit.disabled = false;
				}
			});
		}
	</script>
)}

<style>
	.contact-form {
		display: flex;
		flex-direction: column;
		gap: var(--space-5);
	}

	.field {
		display: flex;
		flex-direction: column;
		gap: var(--space-2);
	}

	.field label {
		font-family: var(--font-ui);
		font-size: var(--text-body-sm);
		font-weight: 500;
		color: var(--text-primary);
	}

	.field .optional {
		color: var(--text-tertiary);
		font-weight: 400;
		font-size: var(--text-micro);
		text-transform: uppercase;
		letter-spacing: var(--tracking-wide);
		margin-left: var(--space-2);
	}

	.field-hint {
		font-family: var(--font-ui);
		font-size: var(--text-micro);
		color: var(--text-tertiary);
	}

	.field input,
	.field textarea {
		font-family: var(--font-body);
		font-size: var(--text-body);
		color: var(--text-primary);
		background: var(--night-2);
		border: 1px solid var(--border-hairline);
		border-radius: var(--radius-sm);
		padding: var(--space-3) var(--space-4);
		width: 100%;
		transition: border-color var(--duration-base) var(--ease-out);
	}

	.field textarea {
		resize: vertical;
		min-height: 160px;
		line-height: 1.6;
	}

	.field input:focus-visible,
	.field textarea:focus-visible {
		outline: none;
		border-color: var(--bronze);
	}

	/* Lets the flex item shrink to the form's content box instead of growing to
	   the widget's width; the script picks a widget size that fits inside it. */
	.turnstile-slot {
		min-width: 0;
		max-width: 100%;
	}

	/* Kept in the layout but out of sight and out of the a11y tree — a sighted
	   or screen-reader user should never encounter it, only a form-filling bot. */
	.honeypot {
		position: absolute;
		width: 1px;
		height: 1px;
		overflow: hidden;
		clip-path: inset(50%);
		white-space: nowrap;
	}

	/* Dev-server affordance — never rendered in a built site. */
	.dev-note {
		font-family: var(--font-ui);
		font-size: var(--text-micro);
		line-height: 1.6;
		color: var(--text-tertiary);
		border-left: 2px solid var(--bronze-dim);
		padding-left: var(--space-3);
		margin: 0;
	}

	.dev-note code {
		font-size: 11px;
		color: var(--text-secondary);
	}

	.form-actions {
		display: flex;
		align-items: center;
		gap: var(--space-4);
		flex-wrap: wrap;
	}

	.form-status {
		font-family: var(--font-ui);
		font-size: var(--text-body-sm);
		color: var(--text-secondary);
		margin: 0;
	}

	.form-status[data-state="ok"] {
		color: var(--bronze-bright);
	}

	.form-status[data-state="error"] {
		color: #e2a0a0;
	}

	button:disabled {
		opacity: 0.5;
		cursor: not-allowed;
	}
</style>
