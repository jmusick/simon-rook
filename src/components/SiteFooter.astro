---
import { GA_MEASUREMENT_ID, SITE_NAME, SITE_VERSION } from "../config/site";
import SocialLinks from "./SocialLinks.astro";

const year = new Date().getFullYear();
---

<footer class="site-footer">
	<span class="footer-mark">{SITE_NAME}</span>

	<SocialLinks />

	<span class="footer-legal">
		<span>© {year} {SITE_NAME}</span>
		<span aria-hidden="true">·</span>
		<span>v{SITE_VERSION}</span>
		<span aria-hidden="true">·</span>
		<a href="/privacy-policy/">Privacy Policy</a>
		{GA_MEASUREMENT_ID && (
			<>
				<span aria-hidden="true">·</span>
				{/* Reopens the consent banner — see src/components/CookieConsent.astro. */}
				<button type="button" class="footer-link-button" data-cookie-preferences>
					Cookie choices
				</button>
			</>
		)}
		<span aria-hidden="true">·</span>
		<span>Site design by <a href="https://stonedragonmedia.com/" target="_blank" rel="noopener noreferrer">Stone Dragon Media, LLC</a></span>
	</span>
</footer>
