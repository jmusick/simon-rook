---
import { Icon } from "astro-icon/components";
import { ACTIVE_SOCIALS } from "../config/site";

interface Props {
	style?: string;
}

const { style } = Astro.props;
---

{ACTIVE_SOCIALS.length > 0 && (
	<nav class="social-nav" style={style} aria-label="Author profiles">
		{ACTIVE_SOCIALS.map((s) => (
			<a
				href={s.href}
				target="_blank"
				rel="noopener noreferrer"
				aria-label={s.label}
				class="social-link"
			>
				<Icon name={s.icon} aria-hidden="true" />
			</a>
		))}
	</nav>
)}
